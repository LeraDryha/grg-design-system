import type { Meta, StoryObj } from '@storybook/react-vite';
import { SocialButton, type SocialButtonProps } from './SocialButton';

const meta = {
  title: 'Components/Social Button',
  component: SocialButton,
  tags: ['autodocs'],
  parameters: {
    docs: {
      description: {
        component:
          'Sign in or sign up with a Google, Facebook or Apple account. Full width under the main action in sign-up and log-in forms; ' +
          'the square version fits where space is tight. Brand logos keep their colours; the Apple logo follows the theme.',
      },
    },
  },
  args: { social: 'google', iconOnly: false, previewState: 'default' },
  argTypes: {
    social: { control: 'inline-radio', options: ['google', 'facebook', 'apple'] },
    previewState: { control: 'inline-radio', options: ['default', 'hover', 'active', 'focus'] },
    children: { control: 'text', description: 'Label; "Sign in with …" by default' },
    onClick: { action: 'clicked', control: false },
    ref: { control: false, table: { disable: true } },
  },
} satisfies Meta<typeof SocialButton>;

export default meta;
type Story = StoryObj<typeof meta>;

export const Playground: Story = {};

/** The three accounts, full width as in the sign-up form. */
export const Accounts: Story = {
  render: (args: SocialButtonProps) => (
    <div style={{ display: 'grid', gap: 'var(--space-200)', width: 376 }}>
      <SocialButton {...args} social="facebook" />
      <SocialButton {...args} social="google" />
      <SocialButton {...args} social="apple" />
    </div>
  ),
};

/** Square buttons with the logo only. */
export const IconOnly: Story = {
  render: (args: SocialButtonProps) => (
    <div style={{ display: 'flex', gap: 'var(--space-200)' }}>
      <SocialButton {...args} social="facebook" iconOnly />
      <SocialButton {...args} social="google" iconOnly />
      <SocialButton {...args} social="apple" iconOnly />
    </div>
  ),
};

/** Default, hovered, active and focused. */
export const States: Story = {
  render: (args: SocialButtonProps) => (
    <div style={{ display: 'grid', gap: 'var(--space-300)', justifyItems: 'start' }}>
      <SocialButton {...args} />
      <SocialButton {...args} previewState="hover" />
      <SocialButton {...args} previewState="active" />
      <SocialButton {...args} previewState="focus" />
    </div>
  ),
};
